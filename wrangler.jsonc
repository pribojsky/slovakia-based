{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slovakia-based-steep",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CATEGORY_ROOM",
        "class_name": "CategoryRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CategoryRoom"]
    }
  ]
}
